# .env.integration — بيانات اختبارات Integration
# ⚠️  مهم: لا تضع هنا بيانات بيئة الإنتاج (حلواني لينزا)
# ⚠️  مهم: أضف هذا الملف إلى .gitignore

# ─────────────────────────────────────────────────────────────────
# قاعدة بيانات Staging / Test (النسخة العامة — ليست لينزا الحية)
# ─────────────────────────────────────────────────────────────────
INT_SUPABASE_URL=https://pjvphxfschfllpawfewn.supabase.co
INT_SUPABASE_ANON_KEY=your_anon_key_here
INT_SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─────────────────────────────────────────────────────────────────
# بيانات اعتماد مستخدم الاختبار (super_admin أو admin على Staging)
# ─────────────────────────────────────────────────────────────────
INT_TEST_ADMIN_EMAIL=test.admin@yourcompany.com
INT_TEST_ADMIN_PASSWORD=your_secure_test_password

# ─────────────────────────────────────────────────────────────────
# ملاحظة: كيفية تشغيل الاختبارات
# ─────────────────────────────────────────────────────────────────
# npm run test:integration
