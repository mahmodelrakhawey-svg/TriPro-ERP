# ملف بيانات اختبارات E2E - انسخ هذا الملف إلى .env.e2e واملأ البيانات
# IMPORTANT: لا تضع بيانات حساب لينزا الحقيقية هنا
# استخدم حسابات اختبار مخصصة على قاعدة بيانات التطوير فقط

# حساب سوبر أدمن للاختبار (من قاعدة الإنتاج العام pjvphxfschfllpawfewn، لا من لينزا)
E2E_SUPER_ADMIN_EMAIL=your_test_admin@example.com
E2E_SUPER_ADMIN_PASSWORD=your_test_password

# حساب موظف الكاشير للاختبار
E2E_CASHIER_EMAIL=cashier_test@example.com
E2E_CASHIER_PASSWORD=cashier_test_password

# حساب موظف المشتريات (اختياري - إذا لم يُضبط يستخدم حساب الكاشير)
E2E_PURCHASE_EMAIL=purchase_test@example.com
E2E_PURCHASE_PASSWORD=purchase_test_password

# ملاحظة: تشغيل الاختبارات
# 1. انسخ هذا الملف: copy .env.e2e.example .env.e2e
# 2. اضبط قيمك الحقيقية في .env.e2e
# 3. شغّل: npx playwright test --env-file .env.e2e
# أو: npm run test:e2e
